#!/usr/bin/env bash
# hrdw-create — thin delegator to hrdw::create (the zsh implementation).
# All naming/worktree logic lives in zsh/modules/herdr; this shim only
# handles -h/--help, resolves this checkout's zshrc, and re-enters zsh.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: hrdw-create <branch-name>

Create a worktree for <branch-name> by delegating to the shared
implementation (hrdw::create). A recognized git-flow prefix is added
automatically when the name does not carry one.

Arguments:
  branch-name    Name of the branch to create

Examples:
  hrdw-create RD-21

Notes:
  Thin delegator: naming and worktree logic live in zsh/modules/herdr.
  Run with no arguments to see the implementation's own usage message.
EOF
  exit 0
fi

# Resolve this checkout's zsh/zshrc from this script's own location
# (bin/ -> herdr -> modules -> zsh) — never from PATH.
_zshrc="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)/zshrc"

# Re-enter zsh: source the checkout's zshrc with module-load chatter
# suppressed, then run the shared function. exec carries its exit code.
exec zsh -f -c '
  if [[ -n "${HERDR_SHIM_DEBUG:-}" ]]; then
    source "$1"
  else
    source "$1" >/dev/null 2>&1
  fi
  if (( ! $+functions[hrdw::create] )); then
    print -u2 "hrdw-create: failed to load hrdw::create from $1"
    print -u2 "hrdw-create: re-run with HERDR_SHIM_DEBUG=1 to see module-load output"
    exit 1
  fi
  shift
  hrdw::create "$@"
' hrdw-create "$_zshrc" "$@"
