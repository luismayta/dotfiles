#!/usr/bin/env bash
# hrdw-delete — thin delegator to hrdw::remove (the zsh implementation).
# All naming/worktree logic lives in zsh/modules/herdr; this shim only
# handles -h/--help, resolves this checkout's zshrc, and re-enters zsh.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: hrdw-delete [<workspace-id>] [--force]

Remove a worktree by workspace ID, or interactively when no ID is
given, delegating to the shared implementation (hrdw::remove).

Arguments:
  workspace-id   Workspace ID (or branch) of the worktree to remove
  --force        Force removal even with uncommitted changes

Examples:
  hrdw-delete                -> interactive selector
  hrdw-delete RD-21          -> remove the RD-21 worktree
  hrdw-delete RD-21 --force  -> force removal
EOF
  exit 0
fi

# Resolve this checkout's zsh/zshrc from this script's own location
# (bin/ -> herdr -> modules -> zsh) — never from PATH.
_zshrc="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)/zshrc"

# Re-enter zsh: source the checkout's zshrc with module-load chatter
# suppressed, then run the shared function. exec carries its exit code.
exec zsh -f -c '
  if [[ -n "${HERDR_SHIM_DEBUG:-}" ]]; then
    source "$1"
  else
    source "$1" >/dev/null 2>&1
  fi
  if (( ! $+functions[hrdw::remove] )); then
    print -u2 "hrdw-delete: failed to load hrdw::remove from $1"
    print -u2 "hrdw-delete: re-run with HERDR_SHIM_DEBUG=1 to see module-load output"
    exit 1
  fi
  shift
  hrdw::remove "$@"
' hrdw-delete "$_zshrc" "$@"
