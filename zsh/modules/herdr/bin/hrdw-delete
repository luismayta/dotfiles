#!/usr/bin/env bash
# hrdw-delete — remove a worktree by workspace ID or via fzf
# Standalone CLI wrapper for hrdw::remove functionality

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

_log() {
  echo -e "${GREEN}==>${NC} $*"
}

_error() {
  echo -e "${RED}==> Error:${NC} $*" >&2
}

_info() {
  echo -e "${BLUE}==>${NC} $*"
}

_warn() {
  echo -e "${YELLOW}==> Warning:${NC} $*"
}

# Check if we're in a git repository
_is_git_repo() {
  git rev-parse --is-inside-work-tree &>/dev/null
}

# Get the root of the git repository
_git_root() {
  git rev-parse --show-toplevel
}

# Check if fzf is available
_has_fzf() {
  command -v fzf &>/dev/null
}

# Fuzzy select a worktree using fzf
_fzf_select() {
  local prompt="${1:-Select worktree: }"
  
  if ! _has_fzf; then
    _error "fzf is required for interactive selection"
    _info "Install fzf: https://github.com/junegunn/fzf"
    exit 1
  fi
  
  local git_root
  git_root="$(_git_root)"
  
  # Get worktree list and format for fzf
  local worktree_list
  worktree_list="$(git worktree list | grep -v "$git_root" | awk '{print $2}' | xargs -I {} basename {})"
  
  if [[ -z "$worktree_list" ]]; then
    _warn "No worktrees found to select"
    exit 1
  fi
  
  # Use fzf to select
  echo "$worktree_list" | fzf --prompt="$prompt" --height=20%
}

# Remove a worktree by branch name
_remove_worktree() {
  local branch="$1"
  local force="${2:-}"
  
  # Get worktree path for this branch
  local worktree_path
  worktree_path="$(git worktree list | grep "$branch" | awk '{print $1}' | head -1)"
  
  if [[ -z "$worktree_path" ]]; then
    _error "No worktree found for branch: $branch"
    exit 1
  fi
  
  # Confirm removal
  local project_context
  project_context="$(basename "$(_git_root)")"
  local branch_part="${branch##*/}"
  
  printf 'Remove worktree "%s/%s" at %s? (y/N) ' "$project_context" "$branch_part" "$worktree_path"
  # shellcheck disable=SC2162
  read -q reply
  printf '\n'
  
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    _info "Removal cancelled"
    return 0
  fi
  
  # Remove the worktree
  _log "Removing worktree: ${worktree_path}"
  
  local cmd="git worktree remove"
  if [[ "$force" == "--force" ]]; then
    cmd="$cmd --force"
  fi
  
  if $cmd "$worktree_path"; then
    _log "Worktree removed successfully!"
  else
    _error "Failed to remove worktree"
    _info "Try with --force flag if there are uncommitted changes"
    exit 1
  fi
}

# Show usage information
_usage() {
  cat << EOF
Usage: hrdw-delete [<workspace-id>] [--force]

Remove a git worktree.

Arguments:
  workspace-id   Branch name or workspace ID of the worktree to remove
  --force        Force removal even with uncommitted changes

Examples:
  hrdw-delete                  -> interactive fzf selector
  hrdw-delete feature/RD-21   -> remove worktree for branch feature/RD-21
  hrdw-delete RD-21 --force   -> force remove worktree for branch RD-21

EOF
}

# Main function
_main() {
  # Check for help argument
  if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    _usage
    exit 0
  fi

  # Check if we're in a git repository
  if ! _is_git_repo; then
    _error "Not a git repository: ${PWD}"
    exit 1
  fi

  local id="${1:-}"
  local force=""
  
  # Check for --force flag
  if [[ "${2:-}" == "--force" ]]; then
    force="--force"
  fi
  
  # If no ID provided, use fzf selector
  if [[ -z "$id" ]]; then
    if ! _has_fzf; then
      _error "fzf is required for interactive selection"
      _info "Install fzf: https://github.com/junegunn/fzf"
      _info "Or provide a branch name: hrdw-delete <branch-name>"
      exit 1
    fi
    
    id="$(_fzf_select "Remove worktree: ")"
    if [[ -z "$id" ]]; then
      _info "No worktree selected"
      exit 0
    fi
  fi
  
  # Auto-prefix same as create
  if [[ "$id" != feature/* ]] \
    && [[ "$id" != fix/* ]] \
    && [[ "$id" != bugfix/* ]] \
    && [[ "$id" != hotfix/* ]] \
    && [[ "$id" != chore/* ]]; then
    id="feature/${id}"
  fi
  
  # Remove the worktree
  _remove_worktree "$id" "$force"
}

# Run the main function
_main "$@"