#!/usr/bin/env bash
# hrdw-list — list all worktrees for the current repo
# Standalone CLI wrapper for hrdw::list functionality

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

_log() {
  echo -e "${GREEN}==>${NC} $*"
}

_error() {
  echo -e "${RED}==> Error:${NC} $*" >&2
}

_info() {
  echo -e "${BLUE}==>${NC} $*"
}

_warn() {
  echo -e "${YELLOW}==> Warning:${NC} $*"
}

# Check if we're in a git repository
_is_git_repo() {
  git rev-parse --is-inside-work-tree &>/dev/null
}

# Get the root of the git repository
_git_root() {
  git rev-parse --show-toplevel
}

# List all worktrees
_list_worktrees() {
  local git_root
  git_root="$(_git_root)"
  
  _info "Worktrees for repository: $(basename "$git_root")"
  echo ""
  
  # Get worktree list
  local worktree_list
  worktree_list="$(git worktree list)"
  
  if [[ -z "$worktree_list" ]]; then
    _warn "No worktrees found"
    return 0
  fi
  
  # Format and display worktrees
  echo "Branch | Path | Status"
  echo "-------|------|-------"
  
  while IFS= read -r line; do
    # Extract path and branch from worktree list
    local path branch status
    path="$(echo "$line" | awk '{print $1}')"
    branch="$(echo "$line" | awk '{print $2}')"
    
    # Get status for this worktree
    if [[ "$path" == "$git_root" ]]; then
      status="main"
    else
      # Check if there are uncommitted changes
      if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
        status="dirty"
      else
        status="clean"
      fi
    fi
    
    # Format branch name for display
    local display_branch
    if [[ "$branch" == *"detached"* ]]; then
      display_branch="(detached)"
    else
      display_branch="${branch#refs/heads/}"
    fi
    
    echo "${display_branch} | ${path} | ${status}"
  done <<< "$worktree_list"
  
  echo ""
  _info "Total worktrees: $(echo "$worktree_list" | wc -l)"
}

# Show usage information
_usage() {
  cat << EOF
Usage: hrdw-list

List all worktrees for the current git repository.

Examples:
  hrdw-list          -> shows all worktrees with branch, path, and status

EOF
}

# Main function
_main() {
  # Check for help argument
  if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    _usage
    exit 0
  fi

  # Check if we're in a git repository
  if ! _is_git_repo; then
    _error "Not a git repository: ${PWD}"
    exit 1
  fi

  # List worktrees
  _list_worktrees
}

# Run the main function
_main "$@"