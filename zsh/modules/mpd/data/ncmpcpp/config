# ncmpcpp configuration for MPD module
# Docs: https://github.com/ncmpcpp/ncmpcpp/blob/master/doc/ncmpcpp.1.asciidoc

# Connection
mpd_host = "localhost"
mpd_port = "6600"
mpd_connection_timeout = "60"

# Music paths
mpd_music_dir = "~/Music"

# Visualizer
visualizer_data_source = "/tmp/mpd.fifo"
visualizer_look = "●▮"
visualizer_type = "spectrum"

# Interface
user_interface = "alternative"
startup_screen = "playlist"

