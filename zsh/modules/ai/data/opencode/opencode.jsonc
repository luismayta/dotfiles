{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "instructions": [
    "AGENTS.md"
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": false,
    "buffer": 8000
  },
  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ]
      },
      "rea": {
        "disabled": false,
        "type": "local",
        "command": [
          "bunx",
          "rea-agents@6.7.0",
          "mcp"
        ],
        "enabled": true
      },
      "postgres": {
        "disabled": false,
        "type": "local",
        "command": [
          "bunx",
          "@microsoft/postgres-mcp",
          "run"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "bunx",
          "@cyanheads/git-mcp-server@latest"
        ],
        "cwd": ".",
        "environment": {
          "MCP_TRANSPORT_TYPE": "stdio",
          "MCP_LOG_LEVEL": "warn",
          "MCP_RESPONSE_FORMAT": "json",
          "MCP_RESPONSE_VERBOSITY": "minimal"
        },
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@playwright/mcp"
        ],
        "disabled": false
      },
      "google_workspace": {
        "type": "local",
        "command": [
          "/home/lucho/.local/bin/workspace-mcp",
          "--single-user",
          "--tools",
          "drive",
          "gmail",
          "calendar",
          "chat",
          "contacts",
          "search",
          "sheets",
          "docs",
          "tasks"
        ],
        "environment": {
          "GOOGLE_OAUTH_CLIENT_ID": "{env:GOOGLE_OAUTH_CLIENT_ID}",
          "GOOGLE_OAUTH_CLIENT_SECRET": "{env:GOOGLE_OAUTH_CLIENT_SECRET}"
        },
        "disabled": false
      },
      "awslabs.aws-knowledge": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws",
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--headless",
          "true"
        ],
        "disabled": true
      },
      "memglobal": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory",
          "--file-path",
          "/home/lucho/.config/opencode/memory.json"
        ],
        "disabled": true
      },
      "markitdown": {
        "type": "local",
        "command": [
          "uvx",
          "markitdown-mcp"
        ],
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ],
        "disabled": false
      },
      "docker": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "docker-mcp"
        ],
        "environment": {
          "DOCKER_MCP_LOCAL": "true",
          "DOCKER_MCP_HOST": "{env:DOCKER_MCP_HOST}",
          "DOCKER_MCP_USERNAME": "{env:DOCKER_MCP_USERNAME}",
          "DOCKER_MCP_PRIVATE_KEY": "{env:DOCKER_MCP_PRIVATE_KEY}",
          "DOCKER_MCP_PORT": "{env:DOCKER_MCP_PORT}",
          "DOCKER_MCP_PASSPHRASE": "{env:DOCKER_MCP_PASSPHRASE}"
        },
        "disabled": false
      },
      "filesystem": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@modelcontextprotocol/server-filesystem"
        ],
        "environment": {
          "ROOT": "."
        },
        "disabled": false
      },
      "github": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GH_TOKEN}"
        },
        "disabled": false
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "hashicorp_terraform": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "hashicorp/terraform-mcp-server:latest"
        ],
        "disabled": false
      },
      "image-compression": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@inhiblab-core/mcp-image-compression"
        ],
        "environment": {
          "IMAGE_COMPRESSION_DOWNLOAD_DIR": "assets/images"
        },
        "disabled": false
      },
      "jira": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "oauth": {},
        "disabled": false
      },
      "notebooklm": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "notebooklm-mcp@latest"
        ],
        "disabled": true
      },
      "obsidian": {
        "type": "remote",
        "url": "http://127.0.0.1:27123/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
        },
        "disabled": false
      },
      "scrapling": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "scrapling[ai]",
          "scrapling-mcp"
        ],
        "disabled": false
      },
      "sentry": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-sentry"
        ],
        "environment": {
          "SENTRY_AUTH_TOKEN": "{env:SENTRY_AUTH_TOKEN}"
        },
        "disabled": true
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ],
        "disabled": true
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server"
        ],
        "disabled": true
      },
      "supabase": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "supabase-mcp@latest",
          "supabase-mcp-claude"
        ],
        "environment": {
          "SUPABASE_URL": "{env:SUPABASE_URL}",
          "SUPABASE_ANON_KEY": "{env:SUPABASE_ANON_KEY}",
          "SUPABASE_SERVICE_ROLE_KEY": "{env:SUPABASE_SERVICE_ROLE_KEY}",
          "MCP_API_KEY": "{env:SUPABASE_MCP_API_KEY}"
        },
        "disabled": true
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "cwd": ".",
        "disabled": false
      },
      "crawl4ai": {
        "type": "remote",
        "url": "http://localhost:11235/mcp/sse",
        "headers": {
          "Authorization": "Bearer crawl4ai-local-dev"
        },
        "disabled": true
      },
      "scopus": {
        "type": "local",
        "command": [
          "/home/lucho/.local/share/scopus-mcp/.venv/bin/scopus-mcp"
        ],
        "environment": {
          "SCOPUS_API_KEY": "{env:SCOPUS_API_KEY}"
        },
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/codi/build/*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    {
      "package": "file:///home/lucho/.config/opencode/node_modules/@codiplab/codi-opencode",
      "options": {}
    }
  ],
  "providers": {
    "freellmapi": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "FreeLLMAPI",
      "settings": {
        "baseURL": "http://localhost:3009/v1",
        "apiKey": "freellmapi-0801ad72b3ee023f16205059a0ee40fa011ff3133bbc9080"
      },
      "models": {
        "auto": {
          "name": "Auto (router picks the best available model)",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "fusion": {
          "name": "Fusion (panel of models answer in parallel, a judge synthesizes one answer)",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "claude-opus-4-5": {
