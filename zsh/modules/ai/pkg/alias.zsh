# shellcheck shell=bash
# AI tool aliases

# hunk diff/review aliases
alias hunk-review='hunk diff'
alias hunk-show='hunk show'
alias hunk-watch='hunk diff --watch'

# graphify aliases
alias graphify-build='graphify build'
alias graphify-query='graphify query'

# archify aliases
alias archify-render='archify render'
alias archify-validate='archify validate'
alias archify-deliver='archify deliver'
alias archify-doctor='archify doctor'
