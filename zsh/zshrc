#!/usr/bin/env zsh
# -*- coding: utf-8 -*-
: "${ZSH_DEBUG:=}"

if [ -n "${ZSH_DEBUG}" ]; then
    zmodload zsh/zprof
fi

export ZSH=${HOME}/.dotfiles
export DOTFILES="${HOME}/.dotfiles"
export DOTFILES_PATH="${DOTFILES}"
export DOTFILES_BIN="${DOTFILES}/bin"
export DOTFILES_ZSH_PATH="${DOTFILES_PATH}/zsh"
export DOTFILES_CORE_PATH="${DOTFILES_ZSH_PATH}/system/core"
export DOTFILES_SYSTEM_PATH="${DOTFILES_ZSH_PATH}/system"

autoload -Uz compinit add-zsh-hook is-at-least

# shellcheck source=/dev/null
[ -e "${DOTFILES_ZSH_PATH}/detect/terminal.zsh" ] && source "${DOTFILES_ZSH_PATH}/detect/terminal.zsh"

# shellcheck source=/dev/null
[ -e "${DOTFILES_CORE_PATH}/main.zsh" ] && source "${DOTFILES_CORE_PATH}/main.zsh"

# Load system modules from system/ directory (excluding core — loaded via main.zsh)
# To disable a system module, set ZSH_DISABLED_MODULES in ~/.customrc
for __module_dir in "${DOTFILES_SYSTEM_PATH}"/*(/N); do
  __module_name="${__module_dir:t}"
  # Skip core (loaded via main.zsh above)
  if [[ "${__module_name}" == "core" ]]; then
    continue
  fi
  if [ -e "${__module_dir}/plugin.zsh" ]; then
    # Respect ZSH_DISABLED_MODULES (space or comma separated)
    if [[ -n "${ZSH_DISABLED_MODULES:-}" ]] && [[ ",${ZSH_DISABLED_MODULES// /,}," == *",${__module_name},"* ]]; then
      continue
    fi
    source "${__module_dir}/plugin.zsh"
  fi
done
unset __module_name __module_dir

# Bootstrap customrc from example template if not present
if [[ ! -e "${CUSTOMRC:-${HOME}/.customrc}" ]] && [[ -e "${DOTFILES_PATH}/.customrc.example" ]]; then
  cp "${DOTFILES_PATH}/.customrc.example" "${CUSTOMRC:-${HOME}/.customrc}"
fi

# shellcheck source=/dev/null
[ -s "${CUSTOMRC:-${HOME}/.customrc}" ] && source "${CUSTOMRC:-${HOME}/.customrc}"

# Load modules from modules/ directory
# To disable a module, set ZSH_DISABLED_MODULES in ~/.customrc:
#   export ZSH_DISABLED_MODULES="tmux"
#   export ZSH_DISABLED_MODULES="tmux starship"
#   export ZSH_DISABLED_MODULES="tmux,starship"
for __module_dir in "${DOTFILES_ZSH_PATH}"/modules/*(/N); do
  if [ -e "${__module_dir}/plugin.zsh" ]; then
    # Skip if module is in ZSH_DISABLED_MODULES (space or comma separated)
    __module_name="${__module_dir:t}"
    if [[ -n "${ZSH_DISABLED_MODULES:-}" ]] && [[ ",${ZSH_DISABLED_MODULES// /,}," == *",${__module_name},"* ]]; then
      continue
    fi
    source "${__module_dir}/plugin.zsh"
  fi
done
unset __module_name __module_dir

# Load antidote bundles (module installs the manager on demand)
touch "${HOME}/.custom_zsh_plugins.txt"
[[ -n "${__ZSH_ANTIDOTE_LOADED:-}" ]] && antidote::init

setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

# core::path::clean only collapses adjacent duplicates (uniq); -U also
# removes interleaved ones and keeps later prepends from re-accumulating them
if (( $+functions[core::path::clean] )); then
    export PATH="$(core::path::clean "${PATH}")"
    export FPATH="$(core::path::clean "${FPATH}")"
fi
typeset -U path
typeset -U fpath

# Auto completion
# 24h freshness check: a dump whose mtime is within the last 24 hours is
# loaded with compinit -C (no fpath rescan); a missing or older dump gets a
# full compinit, which rewrites it only when $fpath actually changed. This is
# the only compinit that writes the dump.
if [ -z "${ZSH_DEBUG}" ]; then
    function {
        local -a mt
        zmodload zsh/stat 2>/dev/null
        zmodload zsh/datetime 2>/dev/null
        if (( $+builtins[zstat] && $+EPOCHSECONDS )) \
            && zstat -A mt +mtime "${ZDOTDIR:-$HOME}/.zcompdump" 2>/dev/null \
            && (( ${#mt} && EPOCHSECONDS - mt[1] <= 86400 )); then
            compinit -C
        else
            compinit
        fi
    }
fi

if [ -n "${ZSH_DEBUG}" ]; then
    zprof
fi

# bun completions
[ -s "${HOME}/.bun/_bun" ] && source "${HOME}/.bun/_bun"

# Added by jcode installer
export PATH="${HOME}/.local/bin:$PATH"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# fnm — only when mise is absent; mise-managed directories are owned by mise
# (guard provided by the nodejs module). When mise exists, skip entirely so its
# shims keep PATH precedence.
if ! command -v mise >/dev/null 2>&1; then
  if [ -d "${FNM_PATH}" ]; then
    export PATH="${FNM_PATH}:${PATH}"
    eval "$(fnm env --shell zsh)"
  fi
fi
