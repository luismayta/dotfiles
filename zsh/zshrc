#!/usr/bin/env zsh
# -*- coding: utf-8 -*-
unset ZSH_DEBUG

# Add some completions (we need this before compinit)
[ -e /usr/share/zsh ] && fpath=(/usr/share/zsh/site-functions:/usr/share/zsh/functions/Calendar:/usr/share/zsh/functions/Chpwd:/usr/share/zsh/functions/Completion:/usr/share/zsh/functions/Completion/Base:/usr/share/zsh/functions/Completion/Linux:/usr/share/zsh/functions/Completion/Unix:/usr/share/zsh/functions/Completion/X:/usr/share/zsh/functions/Completion/Zsh:/usr/share/zsh/functions/Exceptions:/usr/share/zsh/functions/Math:/usr/share/zsh/functions/MIME:/usr/share/zsh/functions/Misc:/usr/share/zsh/functions/Newuser:/usr/share/zsh/functions/Prompts:/usr/share/zsh/functions/TCP:/usr/share/zsh/functions/VCS_Info:/usr/share/zsh/functions/VCS_Info/Backends:/usr/share/zsh/functions/Zftp:/usr/share/zsh/functions/Zle $fpath)
#

export ZSH=${HOME}/.dotfiles
export DOTFILES="${HOME}/.dotfiles"
export DOTFILES_PATH="${DOTFILES}"
export DOTFILES_BIN="${DOTFILES}/bin"
export DOTFILES_ZSH_PATH="${DOTFILES_PATH}/zsh"
export DOTFILES_CORE_PATH="${DOTFILES_ZSH_PATH}/system/core"
export DOTFILES_SYSTEM_PATH="${DOTFILES_ZSH_PATH}/system"

autoload -Uz compinit add-zsh-hook is-at-least

# shellcheck source=/dev/null
[ -e "${DOTFILES_ZSH_PATH}/detect/terminal.zsh" ] && source "${DOTFILES_ZSH_PATH}/detect/terminal.zsh"

# shellcheck source=/dev/null
[ -e "${DOTFILES_CORE_PATH}/main.zsh" ] && source "${DOTFILES_CORE_PATH}/main.zsh"

# Load system modules from system/ directory (excluding core — loaded via main.zsh)
# To disable a system module, set ZSH_DISABLED_MODULES in ~/.customrc
for __module_dir in "${DOTFILES_SYSTEM_PATH}"/*(/N); do
  __module_name="${__module_dir:t}"
  # Skip core (loaded via main.zsh above)
  if [[ "${__module_name}" == "core" ]]; then
    continue
  fi
  if [ -e "${__module_dir}/plugin.zsh" ]; then
    # Respect ZSH_DISABLED_MODULES (space or comma separated)
    if [[ -n "${ZSH_DISABLED_MODULES:-}" ]] && [[ ",${ZSH_DISABLED_MODULES// /,}," == *",${__module_name},"* ]]; then
      continue
    fi
    source "${__module_dir}/plugin.zsh"
  fi
done
unset __module_name __module_dir

# Bootstrap customrc from example template if not present
if [[ ! -e "${CUSTOMRC:-${HOME}/.customrc}" ]] && [[ -e "${DOTFILES_PATH}/.customrc.example" ]]; then
  cp "${DOTFILES_PATH}/.customrc.example" "${CUSTOMRC:-${HOME}/.customrc}"
fi

# shellcheck source=/dev/null
[ -s "${CUSTOMRC:-${HOME}/.customrc}" ] && source "${CUSTOMRC:-${HOME}/.customrc}"


# Load modules from modules/ directory
# To disable a module, set ZSH_DISABLED_MODULES in ~/.customrc:
#   export ZSH_DISABLED_MODULES="tmux"
#   export ZSH_DISABLED_MODULES="tmux starship"
#   export ZSH_DISABLED_MODULES="tmux,starship"
for __module_dir in "${DOTFILES_ZSH_PATH}"/modules/*(/N); do
  if [ -e "${__module_dir}/plugin.zsh" ]; then
    # Skip if module is in ZSH_DISABLED_MODULES (space or comma separated)
    __module_name="${__module_dir:t}"
    if [[ -n "${ZSH_DISABLED_MODULES:-}" ]] && [[ ",${ZSH_DISABLED_MODULES// /,}," == *",${__module_name},"* ]]; then
      continue
    fi
    source "${__module_dir}/plugin.zsh"
  fi
done
unset __module_name __module_dir

if [ -n "${ZSH_DEBUG}" ]; then
    zmodload zsh/zprof
fi

# Load antidote bundles (module installs the manager on demand)
[[ -n "${__ZSH_ANTIDOTE_LOADED:-}" ]] && antidote::init

setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

# remove duplicates path
if (( $+functions[path::clean] )); then
    export PATH="$(path::clean ${PATH})"
    export FPATH="$(path::clean ${FPATH})"
fi

# Auto completion
case "$OSTYPE" in
 darwin*)
if [ $(date +'%j') != $(stat -f '%Sm' -t '%j' ~/.zcompdump) ]; then
    compinit
else
    compinit -d
fi
;;
 linux*)
if [ -z "${ZSH_DEBUG}" ]; then
    compinit
fi
;;
esac

if [ -n "${ZSH_DEBUG}" ]; then
    zprof
fi
