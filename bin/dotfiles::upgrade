#!/usr/bin/env zsh

# Source core framework to make core/message functions available
DOTFILES_PATH="${DOTFILES_PATH:-${HOME}/.dotfiles}"
DOTFILES_CORE_PATH="${DOTFILES_PATH}/zsh/system/core"
source "${DOTFILES_CORE_PATH}/main.zsh"

message_info "Upgrade for dotfiles"
cd "${DOTFILES_PATH}" && git pull origin main && cd - || return
message_success "Upgraded dotfiles"

# shellcheck source=/dev/null
[ -e "${DOTFILES_MOD_DIR}/main.zsh" ] && source "${DOTFILES_MOD_DIR}/main.zsh"

core::internal::backup "${HOME}/.bashrc"
core::internal::backup "${HOME}/.zshrc"
core::internal::backup "${HOME}/.zshenv"

cp -rf "${DOTFILES_PATH}/zsh/zshrc" "${HOME}/.zshrc"
cp -rf "${DOTFILES_PATH}/zsh/zshenv" "${HOME}/.zshenv"
cp -rf "${DOTFILES_PATH}/conf/shell/bashrc" "${HOME}/.bashrc"

message_info "Start Sync config"
rsync -avzh --progress "${DOTFILES_PATH}/config/" "${HOME}/.config/"
message_success "Finish Sync config"
