# =============================================================================
# Custom ZSH Configuration
# =============================================================================
# This file is sourced by zsh/zshrc between the two loader loops:
#   AFTER the zsh/system/* loop (sourcing at zsh/zshrc:43-49; the loop runs at
#   zsh/zshrc:27-40) and BEFORE the zsh/modules/* loop (zsh/zshrc:56-66).
# Consequence: variables set here override module config defaults, but a
# zsh/system/* helper that reads ZSH_DISABLED_MODULES before this point (the
# tmux helper) cannot see it yet.
# Use it to override settings, set environment variables, or disable modules.
#
# Available configuration:
# -----------------------------------------------------------------------------

# Disable specific zsh modules (space or comma separated)
#   export ZSH_DISABLED_MODULES="tmux"
#   export ZSH_DISABLED_MODULES="tmux starship"
#   export ZSH_DISABLED_MODULES="tmux,starship"

# Force-enable or force-disable a single module despite its default
# (the ZSH_<MODULE>_ENABLED guard in plugin.zsh reads this before loading)
#   export ZSH_HYPRLAND_ENABLED=true
#   export ZSH_GIT_ENABLED=false

# Devbox is disabled by default (nix owns installs and project environments).
# Re-enable it for this host:
#   export ZSH_DEVBOX_ENABLED=true
# Or skip it explicitly through the disabled-modules list:
#   export ZSH_DISABLED_MODULES="devbox"
